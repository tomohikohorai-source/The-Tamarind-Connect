{
  "entities": {
    "ReadContent": {
      "title": "ReadContent",
      "description": "Daily stories and columns generated by AI.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["NOVEL", "COLUMN"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "snippet": { "type": "string" },
        "chapterNumber": { "type": "number" },
        "seriesId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "title", "content", "snippet", "createdAt"]
    },
    "ReadSeriesState": {
      "title": "ReadSeriesState",
      "description": "Current state of the novel series.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "currentSeriesId": { "type": "string" },
        "currentChapter": { "type": "number" },
        "lastGeneratedDate": { "type": "string" },
        "characters": { "type": "string" },
        "plotPoints": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["id", "currentSeriesId", "currentChapter", "lastGeneratedDate", "characters", "plotPoints", "title"]
    }
  },
  "firestore": {
    "/readContent/{contentId}": {
      "schema": "ReadContent",
      "description": "Collection of daily reading materials."
    },
    "/readSeriesState/{stateId}": {
      "schema": "ReadSeriesState",
      "description": "State tracking for novel generation."
    }
  }
}
